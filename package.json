{
  "name": "codestellation",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first software knowledge graph and context engine for developers and AI agents.",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "lint": "node scripts/check-format.mjs && node scripts/check-workspace-boundaries.mjs",
    "format:check": "node scripts/check-format.mjs",
    "boundaries:check": "node scripts/check-workspace-boundaries.mjs",
    "quality": "pnpm lint && pnpm typecheck",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
